---
import '@fontsource-variable/gabarito/wght.css';
import '@fontsource-variable/spline-sans-mono/wght.css';
import '../styles/global.css';
import { BRAND, BRAND_LINE, WORDMARK } from '../brand';
import { href, asset } from '../lib/paths';
import { readData } from '../lib/build-data';
import { SILENT } from '../data/silent';
import { STAMP_TOTAL } from '../data/stamps';
import NavMenu, { type NavItem } from '../components/NavMenu';
import sansFont from '@fontsource-variable/gabarito/files/gabarito-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/spline-sans-mono/files/spline-sans-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  preload?: string[];
}

const { title, description = BRAND_LINE, current = '', preload = [] } = Astro.props;
const orbitData = Object.values(import.meta.glob<{ ORBIT_SITES?: unknown[] }>('../data/orbit-sites.ts', { eager: true }))[0];
const ORBIT_FIGURE = orbitData?.ORBIT_SITES ? `${orbitData.ORBIT_SITES.length} sites` : '';
const pageTitle = title ? `${title} · ${BRAND}` : BRAND;
const site = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).toString() : '';
const ogImage = site ? new URL('og.png?v=4', site).toString() : asset('og.png?v=4');

const pageFiles = Object.keys(import.meta.glob('../pages/**/*.astro'));
const has = (name: string) => pageFiles.some((f) => f === `../pages/${name}.astro` || f === `../pages/${name}/index.astro`);

const mars = readData<{ totals: { flights: number } }>('ingenuity.json');

const items: NavItem[] = [
  { key: 'deep-space', href: href('deep-space/'), label: 'Deep space', live: 'v1', meaning: 'Voyager 1’s light time right now' },
  { key: 'moon', href: href('moon/'), label: 'Moon', live: 'moon', meaning: 'Laser echo from Apache Point to the Apollo 15 mirror right now' },
  { key: 'mars', href: href('mars/'), label: 'Mars', figure: `${mars.totals.flights} flights`, meaning: 'Flights Ingenuity made over Jezero crater' },
  ...(has('orbit') ? [{ key: 'orbit', href: href('orbit/'), label: 'Orbit', figure: ORBIT_FIGURE, meaning: 'Landing sites seen again from orbit' }] : []),
  { key: 'silent', href: href('silent/'), label: 'Silent', figure: `${SILENT.length} objects`, meaning: 'Hardware that no longer answers' },
];
const passport: NavItem | null = has('passport')
  ? { key: 'passport', href: href('passport/'), label: 'Passport', live: 'stamps', meaning: 'Stamps collected on this device' }
  : null;
const extra = [
  ...(has('classroom') ? [{ href: href('classroom/'), label: 'Classroom' }] : []),
  { href: href('sources/'), label: 'Sources' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    {preload.map((path) => <link rel="preload" href={asset(path)} as="fetch" crossorigin="anonymous" />)}
    <meta name="theme-color" content="#0D0A18" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={asset('favicon.svg?v=3')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png?v=3')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png?v=3')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        try {
          var raw = sessionStorage.getItem('hullo.wave');
          if (!raw) return;
          sessionStorage.removeItem('hullo.wave');
          var w = JSON.parse(raw);
          if (Date.now() - w.t > 4000) return;
          var root = document.documentElement;
          var x = w.x, y = w.y, vw = window.innerWidth, vh = window.innerHeight;
          var r = Math.ceil(Math.hypot(Math.max(x, vw - x), Math.max(y, vh - y))) + 8;
          root.style.setProperty('--wave-x', x + 'px');
          root.style.setProperty('--wave-y', y + 'px');
          root.style.setProperty('--wave-r', r + 'px');
        } catch (e) {}
      })();
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a || a.target || a.origin !== location.origin) return;
        try {
          var box = a.getBoundingClientRect();
          var x = e.clientX || box.left + box.width / 2;
          var y = e.clientY || box.top + box.height / 2;
          sessionStorage.setItem('hullo.wave', JSON.stringify({ x: Math.round(x), y: Math.round(y), t: Date.now() }));
        } catch (err) {}
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="wordmark" href={href('')} aria-label={`${BRAND} home`} translate="no">{WORDMARK}</a>
        <nav class="bar" aria-label="Chapters">
          <ul class="bar-list">
            {
              items.map((item) => (
                <li>
                  <a class="press bar-item" href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                    <span class="bar-label">{item.label}</span>
                    <span class="bar-fig mono" data-live={item.live} aria-hidden={item.live ? 'true' : undefined}>
                      {item.figure || '\u2007'}
                    </span>
                    {item.live && <span class="sr-only">, {item.meaning}</span>}
                    {current === item.key && <span class="bar-mark" aria-hidden="true" />}
                  </a>
                </li>
              ))
            }
          </ul>
          {
            passport && (
              <a class="press bar-item bar-passport" href={passport.href} aria-current={current === passport.key ? 'page' : undefined}>
                <span class="bar-label">{passport.label}</span>
                <span class="bar-fig mono" data-live="stamps" data-total={STAMP_TOTAL}>
                  {`0 of ${STAMP_TOTAL}`}
                </span>
                {current === passport.key && <span class="bar-mark" aria-hidden="true" />}
              </a>
            )
          }
        </nav>
        <div class="bar-menu">
          <NavMenu client:press items={items} passport={passport} extra={extra} current={current} stampTotal={STAMP_TOTAL} />
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-row">
        <a class="wordmark small" href={href('')} aria-label={`${BRAND} home`} translate="no">{WORDMARK}</a>
        <p>Made for the NASA Space Apps Challenge 2026. Not endorsed by NASA. Every number has a <a href={href('sources/')}>source</a>.</p>
        <ul class="foot-links">
          {
            extra.map((e) => (
              <li>
                <a class="press foot-link" href={e.href}>{e.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
    <script>
      import { shortHms, subscribeFigures } from '../lib/nav-live';
      import { onStamp, stampCount } from '../lib/passport';

      const v1 = document.querySelectorAll<HTMLElement>('.bar [data-live="v1"]');
      const moon = document.querySelectorAll<HTMLElement>('.bar [data-live="moon"]');
      const stamps = document.querySelectorAll<HTMLElement>('.bar [data-live="stamps"]');

      const showStamps = (n: number) =>
        stamps.forEach((el) => {
          el.textContent = `${n} of ${el.dataset.total}`;
        });
      showStamps(stampCount());
      onStamp(showStamps);

      const start = () =>
        subscribeFigures((f) => {
          const a = f.v1LightS === null ? '\u2007' : shortHms(f.v1LightS);
          const b = f.moonEchoS === null ? '\u2007' : `${f.moonEchoS.toFixed(2)} s echo`;
          v1.forEach((el) => el.textContent !== a && (el.textContent = a));
          moon.forEach((el) => el.textContent !== b && (el.textContent = b));
        });
      let started = false;
      const go = () => {
        if (started) return;
        started = true;
        if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
        else setTimeout(start, 300);
      };
      const wide = window.matchMedia('(min-width: 960px)');
      if (wide.matches) go();
      else wide.addEventListener('change', (e) => e.matches && go());
    </script>
  </body>
</html>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    view-transition-name: site-head;
  }
  .head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 36px;
    min-height: 72px;
  }
  .wordmark {
    color: var(--text);
    font-weight: 800;
    font-size: 1.875rem;
    letter-spacing: -0.05em;
    line-height: 1;
    text-decoration: none;
    padding-block: 6px 9px;
    padding-right: 0.08em;
  }
  .wordmark.small {
    font-size: 1.5rem;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    padding-bottom: 4px;
  }
  .bar-list {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bar-item {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 1px;
    min-height: 52px;
    padding: 5px 14px 6px;
    text-align: left;
  }
  .bar-item[aria-current='page'] {
    --p-edge: var(--press-edge);
    --p-lip: var(--press-lip);
  }
  .bar-label {
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }
  .bar-fig {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--muted);
    white-space: nowrap;
  }
  .bar-item [data-live='v1'],
  .bar-item [data-live='moon'] {
    min-width: 11ch;
  }
  .bar-item[aria-current='page'] .bar-label {
    font-weight: 800;
  }
  .bar-item[aria-current='page'] .bar-fig {
    color: var(--text);
  }
  .bar-mark {
    position: absolute;
    inset: -2px;
    border: 2px solid var(--lilac);
    border-radius: var(--press-radius);
    box-shadow: 0 4px 0 var(--lilac);
    pointer-events: none;
    view-transition-name: bar-mark;
    transition: box-shadow 90ms var(--ease);
  }
  .bar-item:active .bar-mark {
    box-shadow: 0 0 0 var(--lilac);
  }
  .bar-passport {
    margin-left: auto;
  }
  .bar-menu {
    display: none;
  }
  .site-foot {
    margin-top: clamp(64px, 10vw, 140px);
    border-top: 1px solid var(--rule);
  }
  .foot-row {
    display: flex;
    align-items: baseline;
    gap: 12px 32px;
    flex-wrap: wrap;
    padding-block: 28px 40px;
  }
  .foot-row p {
    color: var(--muted);
    font-size: var(--fs-sm);
    max-width: 44rem;
  }
  .foot-links {
    display: flex;
    gap: 10px;
    margin-left: auto;
    padding-bottom: 4px;
  }
  .foot-link {
    min-height: 44px;
    padding-inline: 16px;
  }
  @media (max-width: 1180px) {
    .bar,
    .bar-list {
      gap: 6px;
    }
    .bar-item {
      padding-inline: 10px;
    }
  }
  @media (max-width: 959px) {
    .bar {
      display: none;
    }
    .bar-menu {
      display: block;
      padding-bottom: 4px;
    }
    .head-row {
      min-height: 60px;
    }
    .foot-links {
      margin-left: 0;
    }
  }
</style>
