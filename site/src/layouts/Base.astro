---
import '@fontsource-variable/gabarito/wght.css';
import '@fontsource-variable/spline-sans-mono/wght.css';
import '../styles/global.css';
import { BRAND, BRAND_LINE, WORDMARK } from '../brand';
import { href, asset } from '../lib/paths';
import { STAMP_TOTAL } from '../data/stamps';
import NavMenu, { type NavItem } from '../components/NavMenu';
import sansFont from '@fontsource-variable/gabarito/files/gabarito-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/spline-sans-mono/files/spline-sans-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  preload?: string[];
}

const { title, description = BRAND_LINE, current = '', preload = [] } = Astro.props;
const pageTitle = title ? `${title} · ${BRAND}` : BRAND;
const site = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).toString() : '';
const ogImage = site ? new URL('og.png?v=4', site).toString() : asset('og.png?v=4');

const pageFiles = Object.keys(import.meta.glob('../pages/**/*.astro'));
const has = (name: string) => pageFiles.some((f) => f === `../pages/${name}.astro` || f === `../pages/${name}/index.astro`);

const items: NavItem[] = [
  { key: 'deep-space', href: href('deep-space/'), label: 'Deep space' },
  { key: 'moon', href: href('moon/'), label: 'Moon' },
  { key: 'mars', href: href('mars/'), label: 'Mars' },
  ...(has('orbit') ? [{ key: 'orbit', href: href('orbit/'), label: 'Orbit' }] : []),
  { key: 'silent', href: href('silent/'), label: 'Silent' },
];
const passport: NavItem | null = has('passport') ? { key: 'passport', href: href('passport/'), label: 'Passport' } : null;
const extra = [
  ...(has('classroom') ? [{ href: href('classroom/'), label: 'Classroom' }] : []),
  { href: href('sources/'), label: 'Sources' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    {preload.map((path) => <link rel="preload" href={asset(path)} as="fetch" crossorigin="anonymous" />)}
    <meta name="theme-color" content="#0D0A18" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={asset('favicon.svg?v=3')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png?v=3')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png?v=3')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        try {
          var raw = sessionStorage.getItem('hullo.wave');
          if (!raw) return;
          sessionStorage.removeItem('hullo.wave');
          var w = JSON.parse(raw);
          if (Date.now() - w.t > 4000) return;
          var root = document.documentElement;
          var x = w.x, y = w.y, vw = window.innerWidth, vh = window.innerHeight;
          var r = Math.ceil(Math.hypot(Math.max(x, vw - x), Math.max(y, vh - y))) + 8;
          root.style.setProperty('--wave-x', x + 'px');
          root.style.setProperty('--wave-y', y + 'px');
          root.style.setProperty('--wave-r', r + 'px');
        } catch (e) {}
      })();
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a || a.target || a.origin !== location.origin) return;
        try {
          var box = a.getBoundingClientRect();
          var x = e.clientX || box.left + box.width / 2;
          var y = e.clientY || box.top + box.height / 2;
          sessionStorage.setItem('hullo.wave', JSON.stringify({ x: Math.round(x), y: Math.round(y), t: Date.now() }));
        } catch (err) {}
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="wordmark" href={href('')} aria-label={`${BRAND} home`} translate="no">{WORDMARK}</a>
        <nav class="bar" aria-label="Chapters">
          <ul class="bar-list">
            {
              items.map((item) => (
                <li>
                  <a class="bar-item" href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                    <span class="bar-label">{item.label}</span>
                    {current === item.key && <span class="bar-mark" aria-hidden="true" />}
                  </a>
                </li>
              ))
            }
          </ul>
          {
            passport && (
              <a class="bar-item bar-passport" href={passport.href} aria-current={current === passport.key ? 'page' : undefined}>
                <span class="bar-label">{passport.label}</span>
                <span class="bar-fig mono" data-live="stamps" data-total={STAMP_TOTAL}>
                  {`0 of ${STAMP_TOTAL}`}
                </span>
                {current === passport.key && <span class="bar-mark" aria-hidden="true" />}
              </a>
            )
          }
        </nav>
        <div class="bar-menu">
          <NavMenu client:press items={items} passport={passport} extra={extra} current={current} stampTotal={STAMP_TOTAL} />
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-row">
        <a class="wordmark small" href={href('')} aria-label={`${BRAND} home`} translate="no">{WORDMARK}</a>
        <p>Photos from NASA. Not endorsed by NASA.</p>
        <ul class="foot-links">
          {
            extra.map((e) => (
              <li>
                <a class="foot-link" href={e.href}>{e.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var done = function (img) {
          var box = img.closest && img.closest('.ph');
          if (box && img.complete && img.naturalWidth > 0) box.classList.add('ph-done');
        };
        document.addEventListener('load', function (e) { if (e.target && e.target.tagName === 'IMG') done(e.target); }, true);
        var sweep = function () { document.querySelectorAll('.ph img').forEach(done); };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sweep);
        else sweep();
      })();
    </script>
    <script>
      import { onStamp, stampCount } from '../lib/passport';

      const stamps = document.querySelectorAll<HTMLElement>('.bar [data-live="stamps"]');
      const showStamps = (n: number) =>
        stamps.forEach((el) => {
          el.textContent = `${n} of ${el.dataset.total}`;
        });
      showStamps(stampCount());
      onStamp(showStamps);
    </script>
  </body>
</html>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    view-transition-name: site-head;
  }
  .head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 28px;
    min-height: 56px;
  }
  .wordmark {
    color: var(--text);
    font-weight: 800;
    font-size: 1.625rem;
    letter-spacing: -0.05em;
    line-height: 1;
    text-decoration: none;
    padding-block: 6px 9px;
    padding-right: 0.08em;
  }
  .wordmark.small {
    font-size: 1.5rem;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
  }
  .bar-list {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .bar-item {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: baseline;
    gap: 7px;
    min-height: 32px;
    align-items: center;
    padding: 0 14px;
    border-radius: 999px;
    text-decoration: none;
  }
  .bar-item:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .bar-label {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--muted);
    transition: color 90ms var(--ease);
  }
  @media (hover: hover) {
    .bar-item:hover .bar-label {
      color: var(--text);
    }
  }
  .bar-item[aria-current='page'] .bar-label {
    color: var(--bg);
    font-weight: 700;
  }
  .bar-fig {
    font-size: 0.78125rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--muted);
    white-space: nowrap;
  }
  .bar-item[aria-current='page'] .bar-fig {
    color: var(--bg);
  }
  .bar-item [data-live='stamps'] {
    min-width: 7ch;
  }
  .bar-mark {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px;
    background: var(--lilac);
    pointer-events: none;
    view-transition-name: bar-mark;
  }
  .bar-passport {
    margin-left: auto;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--rule);
    min-height: 38px;
  }
  .bar-menu {
    display: none;
  }
  .site-foot {
    margin-top: clamp(40px, 5vw, 72px);
    border-top: 1px solid var(--rule);
  }
  .foot-row {
    display: flex;
    align-items: baseline;
    gap: 12px 32px;
    flex-wrap: wrap;
    padding-block: 28px 40px;
  }
  .foot-row p {
    color: var(--muted);
    font-size: var(--fs-sm);
    max-width: 44rem;
  }
  .foot-links {
    display: flex;
    gap: 10px;
    margin-left: auto;
    padding-bottom: 4px;
  }
  .foot-link {
    color: var(--muted);
    font-size: var(--fs-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .foot-link:hover {
    color: var(--text);
  }
  @media (max-width: 900px) {
    .head-row {
      gap: 12px 14px;
    }
    .bar,
    .bar-list {
      gap: 5px;
    }
    .bar-item {
      gap: 5px;
      padding-inline: 10px;
    }
  }
  @media (max-width: 767px) {
    .bar {
      display: none;
    }
    .bar-menu {
      display: block;
      padding-bottom: 3px;
    }
    .head-row {
      min-height: 52px;
    }
    .foot-links {
      margin-left: 0;
    }
  }
</style>
