---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LaserShot from '../components/LaserShot';
import { href } from '../lib/paths';
import { readData } from '../lib/build-data';
import { dated, image, meta } from '../lib/photos';
import type { MoonIndex } from '../lib/ranging';

const moonIndex = readData<MoonIndex>('moon/index.json');

const mirrors = [
  {
    slug: 'moon-a11-reflector',
    name: 'Apollo 11',
    note: 'The reflector stands beyond the seismometer, with the lunar module on the right.',
    alt: 'An astronaut on the grey surface beside the Apollo 11 seismometer, with the small laser reflector behind it and the lunar module in the distance.',
  },
  {
    slug: 'moon-a14-reflector',
    name: 'Apollo 14',
    note: 'The reflector set up on the surface, with boot prints around it.',
    alt: 'The Apollo 14 laser reflector on the grey surface, a tilted panel of glass corner cubes with boot prints around it.',
  },
  {
    slug: 'moon-a15-reflector',
    name: 'Apollo 15',
    note: 'The reflector still folded on the lunar module’s storage bay, before the crew set it up.',
    alt: 'The side of the Apollo 15 lunar module, with the folded laser reflector on top of a foil wrapped storage bay and boot prints in front.',
  },
].map((m) => ({ ...m, meta: meta(m.slug), image: image(m.slug) }));
---

<Base title="Moon" current="moon" description="Fire a laser from Apache Point or Grasse at an Apollo retroreflector and see the round trip time for this moment, from JPL Horizons.">
  <header class="wrap page-head">
    <h1>Moon</h1>
    <p>Apollo 11, 14 and 15 left mirrors that need no power. Observatories on Earth still bounce lasers off them.</p>
  </header>

  <section class="wrap" aria-label="Laser ranging">
    <LaserShot client:load index={moonIndex} />
  </section>

  <section class="wrap section">
    <div class="moon-more">
      <div class="moon-text">
        <p class="big-claim"><span class="n mono">3.8 cm</span> a year</p>
        <p>
          Laser ranging started at a precision of several decimeters and now reaches millimeters. More than 57 years of echoes
          show the Moon moving away from Earth by about 3.8 cm a year.
        </p>
        <p class="note">
          Each mirror is a panel of glass corner cubes that sends light straight back the way it came. Round trips here are twice
          the station to mirror distance from JPL Horizons, divided by the speed of light. Lunokhod 1 and 2 are Soviet rovers whose
          reflectors are also ranged. <a href={href('sources/')}>Sources</a>
        </p>
      </div>
      <div class="mirrors" role="list" aria-label="The three Apollo reflectors">
        {
          mirrors.map((m) => (
            <figure class="mirror" role="listitem">
              <Picture
                src={m.image}
                formats={['avif', 'webp']}
                widths={[360, 560, 800]}
                sizes="(max-width: 860px) 92vw, 22vw"
                alt={m.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="mirror-name">{m.name}</span>
                <span class="mono mirror-date">{dated(m.meta.date)}</span>
                <span class="credit">{m.note} {m.meta.id.toUpperCase()}, {m.meta.credit}.</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .moon-more {
    display: grid;
    gap: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .mirrors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .mirror {
    display: grid;
    gap: 10px;
    margin: 0;
    align-content: start;
  }
  .mirror :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--raised);
  }
  .mirror figcaption {
    display: grid;
    gap: 2px;
  }
  .mirror-name {
    font-weight: 700;
  }
  .mirror-date {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .moon-text {
    display: grid;
    gap: 18px;
    max-width: 34rem;
  }
  .big-claim {
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .big-claim .n {
    display: block;
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  @media (max-width: 860px) {
    .mirrors {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
