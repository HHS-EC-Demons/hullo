---
import Base from '../layouts/Base.astro';
import LaserShot from '../components/LaserShot';
import PlanetFigure from '../components/PlanetFigure.astro';
import { readData } from '../lib/build-data';
import { meta } from '../lib/photos';
import { calDate } from '../lib/dates';
import type { MoonIndex } from '../lib/ranging';

const moonIndex = readData<MoonIndex>('moon/index.json');
const station = meta('moon-laser-station');
const earthrise = meta('moon-earthrise');

const mirrors = [
  {
    slug: 'moon-a11-reflector',
    what: 'Apollo 11',
    alt: 'An astronaut on the grey surface beside the Apollo 11 seismometer, with the small laser reflector behind the seismometer and the lunar module in the distance.',
  },
  {
    slug: 'moon-a14-reflector',
    what: 'Apollo 14',
    alt: 'The Apollo 14 laser reflector on the grey surface, a tilted panel of glass corner cubes with boot prints around the panel.',
  },
  {
    slug: 'moon-a15-reflector',
    what: 'Apollo 15',
    alt: 'The side of the Apollo 15 lunar module, with the folded laser reflector on top of a foil wrapped storage bay and boot prints in front.',
  },
].map((m) => ({ ...m, meta: meta(m.slug) }));
---

<Base title="Moon" current="moon" description="Fire a laser from Apache Point or Grasse at an Apollo retroreflector and see the round trip time for this moment, from JPL Horizons.">
  <LaserShot client:idle index={moonIndex} chartTitle="This month">
    <Fragment slot="head">
      <h1 class="moon-h1">Moon</h1>
      <p class="moon-line">Lasers still bounce off Apollo mirrors.</p>
    </Fragment>
    <PlanetFigure
      slot="photo"
      slug="moon-laser-station"
      class="moon-hero-photo"
      eager
      sizes="(max-width: 860px) 92vw, 36vw"
      alt="Two green laser beams rise from a laser ranging station and an observatory dome into a deep blue night sky, both pointed at the bright full Moon."
      what="Goddard lasers"
      date={calDate(station.date!)}
      credit={`${station.id}, ${station.credit}`}
    />
  </LaserShot>

  <section class="moon-mirrors section" aria-label="The Apollo mirrors">
    <div class="moon-row">
      {
        mirrors.map((m) => (
          <PlanetFigure
            slug={m.slug}
            class="moon-mirror"
            sizes="(max-width: 860px) 100vw, 33vw"
            widths={[640, 800, 1080, 1800]}
            alt={m.alt}
            what={m.what}
            date={calDate(m.meta.date!)}
            credit={`${m.meta.id.toUpperCase()}, ${m.meta.credit}`}
          />
        ))
      }
    </div>
  </section>

  <section class="moon-drift" aria-label="Earthrise">
    <PlanetFigure
      slug="moon-earthrise"
      class="moon-earthrise"
      sizes="100vw"
      alt="The blue and white Earth, partly in shadow, above the grey cratered horizon of the Moon against a black sky."
      what="Earthrise"
      date={calDate(earthrise.date!)}
      credit={`${earthrise.id.toUpperCase()}, ${earthrise.credit}`}
    />
  </section>
</Base>

<style>
  .moon-h1 {
    font-size: var(--fs-display);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .moon-line {
    margin-top: 16px;
    max-width: var(--measure);
    font-size: var(--fs-md);
    color: var(--muted);
    text-wrap: pretty;
  }
  :global(.moon-hero-photo) {
    --pf-ratio: 4 / 5;
    --pf-pos: 50% 0%;
  }
  .moon-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    max-width: 1920px;
    margin-inline: auto;
  }
  .moon-row :global(.moon-mirror) {
    --pf-ratio: 1;
  }
  .moon-row :global(.moon-mirror) {
    --pf-cap-pad: 12px;
  }
  .moon-drift {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .moon-drift :global(.moon-earthrise) {
    --pf-cap-pad: calc(max(0px, (100% - var(--max)) / 2) + var(--gutter));
    max-width: 1920px;
    margin-inline: auto;
  }
  @media (max-width: 860px) {
    :global(.moon-hero-photo) {
      --pf-ratio: 4 / 3;
    }
    .moon-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .moon-row :global(.moon-mirror) {
      --pf-cap-pad: var(--gutter);
    }
    .moon-drift :global(.moon-earthrise) {
      --pf-ratio: 4 / 3;
    }
  }
</style>
