---
import Base from '../layouts/Base.astro';
import Classroom from '../components/Classroom';
---

<Base title="Classroom" current="classroom" description="Three printable worksheets that use this site’s numbers at the moment of printing, each with an answer key.">
  <header class="wrap page-head">
    <h1>Classroom</h1>
    <p>Three printable worksheets with this site’s numbers from the moment you print, each on one page with the answer key on a second.</p>
  </header>

  <div class="wrap">
    <Classroom client:load />
  </div>
</Base>
