---
import Base from '../layouts/Base.astro';
import Classroom from '../components/Classroom';
---

<Base title="Classroom" current="classroom" description="Three printable worksheets that use this site’s numbers at the moment you print them, each with an answer key.">
  <header class="wrap page-head">
    <h1>Classroom</h1>
    <p>Three worksheets that use this site’s numbers at the moment you print them. Each one prints on one page, with the answer key on a second page.</p>
  </header>

  <div class="wrap">
    <Classroom client:load />
  </div>
</Base>
