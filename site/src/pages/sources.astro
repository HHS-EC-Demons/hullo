---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { SOURCE_GROUPS } from '../data/source-index';
import { BRAND } from '../brand';

interface Pkg {
  version?: string;
  license?: string;
  dependencies?: Record<string, string>;
}

const readPkg = (path: string): Pkg => JSON.parse(readFileSync(resolve(process.cwd(), path), 'utf8')) as Pkg;
const software = Object.keys(readPkg('package.json').dependencies ?? {})
  .filter((name) => !name.startsWith('@fontsource'))
  .map((name) => {
    const pkg = readPkg(`node_modules/${name}/package.json`);
    return { name, version: pkg.version ?? '', license: pkg.license ?? 'see package' };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

const groups = SOURCE_GROUPS.map((g) => ({ ...g, slug: `g-${g.key}` }));
---

<Base title="Sources" current="sources" description={`Every dataset, page and tool ${BRAND} uses, with its license and credit.`}>
  <header class="wrap page-head">
    <h1>Sources</h1>
    <p>Every dataset, page and photo behind this site.</p>
  </header>

  <section class="wrap about" aria-labelledby="about">
    <h2 id="about" class="sr-only">About this site</h2>
    <dl class="facts">
      <div>
        <dt>Written for</dt>
        <dd>Readers 10 to 14 years old, and anyone curious.</dd>
      </div>
      <div>
        <dt>Use of AI</dt>
        <dd>Made with help from Claude by Anthropic. No image is AI generated.</dd>
      </div>
      <div>
        <dt>Passport</dt>
        <dd>Stamps and the certificate name stay in this browser. Nothing is sent.</dd>
      </div>
    </dl>
  </section>

  {
    groups.map((g) => (
      <section class="wrap section" aria-labelledby={g.slug}>
        <h2 class="group" id={g.slug}>
          {g.title}
        </h2>
        <ul class="list">
          {g.items.map((s) => (
            <li id={s.id}>
              <p class="title">
                <a href={s.url} rel="external noopener">{s.title}</a>
              </p>
              <details>
                <summary class="meta">
                  {s.publisher}, {s.dated}
                </summary>
                <p class="used">{s.used}</p>
                {s.note && <p class="note">{s.note}</p>}
                <p class="license">{s.license}</p>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="wrap section" aria-labelledby="tools">
    <h2 class="group" id="tools">Software and fonts</h2>
    <ul class="list tools">
      <li>
        <p class="title">Gabarito and Spline Sans Mono</p>
        <p class="license">Naipe Foundry, and Eben Sorkin and Mirko Velimirović. SIL Open Font License, via Fontsource.</p>
      </li>
      {
        software.map((t) => (
          <li>
            <p class="title">
              <a href={`https://www.npmjs.com/package/${t.name}`} rel="external noopener">{t.name}</a> <span class="mono version">{t.version}</span>
            </p>
            <p class="license mono">{t.license}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .facts {
    display: grid;
    gap: 0;
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }
  .facts div {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    gap: 6px 32px;
    padding-block: 20px;
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    font-weight: 700;
  }
  .facts dd {
    margin: 0;
    max-width: 44rem;
    color: var(--muted);
    text-wrap: pretty;
  }
  .group {
    text-wrap: balance;
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
  }
  .list li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding-block: 18px;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 88px;
  }
  .tools {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .title {
    font-weight: 700;
  }
  .version {
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 400;
  }
  .meta,
  .license {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  details {
    display: grid;
    gap: 6px;
  }
  details[open] {
    padding-bottom: 6px;
  }
  summary {
    cursor: pointer;
    width: fit-content;
    text-underline-offset: 3px;
  }
  summary:hover {
    color: var(--text);
  }
  summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: 2px;
  }
  details > p {
    margin-top: 6px;
  }
  .used,
  .note {
    max-width: 38rem;
  }
  .note {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .facts div {
      grid-template-columns: minmax(0, 1fr);
    }
    .list,
    .tools {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
