---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { SOURCE_GROUPS } from '../data/source-index';
import { BRAND } from '../brand';

interface Pkg {
  version?: string;
  license?: string;
  dependencies?: Record<string, string>;
}

const readPkg = (path: string): Pkg => JSON.parse(readFileSync(resolve(process.cwd(), path), 'utf8')) as Pkg;
const SKIP = new Set(['lucide-react']);
const software = Object.keys(readPkg('package.json').dependencies ?? {})
  .filter((name) => !name.startsWith('@fontsource') && !SKIP.has(name))
  .map((name) => {
    const pkg = readPkg(`node_modules/${name}/package.json`);
    return { name, version: pkg.version ?? '', license: pkg.license ?? 'see package' };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

const groups = SOURCE_GROUPS.map((g) => ({ ...g, slug: `g-${g.key}` }));
const count = groups.reduce((n, g) => n + g.items.length, 0);
---

<Base title="Sources" current="sources" description={`Every dataset, page and tool ${BRAND} uses, with its license and credit.`}>
  <header class="wrap page-head">
    <h1>Sources</h1>
    <p>All {count} datasets and pages behind the numbers on this site, with each license and credit.</p>
  </header>

  <section class="wrap about" aria-labelledby="about">
    <h2 id="about" class="sr-only">About this site</h2>
    <dl class="facts">
      <div>
        <dt>Written for</dt>
        <dd>Readers 10 to 14 years old, and anyone curious.</dd>
      </div>
      <div>
        <dt>Use of AI</dt>
        <dd>
          The code and the research behind this site were built with help from Claude by Anthropic. Every number on the site is
          computed from the data below or quoted from a dated source on this page. No images are AI generated.
        </dd>
      </div>
      <div>
        <dt>NASA</dt>
        <dd>Made for the NASA Space Apps Challenge 2026. This project is not endorsed by NASA.</dd>
      </div>
      <div>
        <dt>Accuracy</dt>
        <dd>
          Probe light time is the geometric distance from Earth’s center divided by the speed of light, the same convention NASA uses
          for its one light-day date. A Moon round trip is twice the distance from the station to the reflector divided by the speed of
          light, shown to the millisecond, with reflector positions in the DE421 mean Earth frame. A shot needs the Moon at least 20°
          above the station’s horizon, a limit this site chose. Pioneer 10 and 11 positions are extrapolated from old tracking. The sky
          chart shows positions seen from Earth’s center at 00:00 UTC. Stars sit at their J2000 catalog positions, and none has moved
          more than 3 arcminutes since, far less than a dot on the chart.
        </dd>
      </div>
      <div>
        <dt>Silent timeline</dt>
        <dd>
          A line starts on the launch date in UTC, or the day the hardware was set up on the Moon, and fades on the last day anyone heard
          from it. Spans count whole calendar months up to today.
        </dd>
      </div>
      <div>
        <dt>Passport</dt>
        <dd>Stamps and the name on the certificate stay in this browser’s local storage. Nothing is sent anywhere.</dd>
      </div>
    </dl>
  </section>

  {
    groups.map((g) => (
      <section class="wrap section" aria-labelledby={g.slug}>
        <h2 class="group" id={g.slug}>
          {g.title}
        </h2>
        <ul class="list">
          {g.items.map((s) => (
            <li id={s.id}>
              <p class="title">
                <a href={s.url} rel="external noopener">{s.title}</a>
              </p>
              <p class="meta">
                {s.publisher}. {s.dated}.
              </p>
              <p class="used">{s.used}</p>
              <p class="license">{s.license}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="wrap section" aria-labelledby="tools">
    <h2 class="group" id="tools">Software and fonts</h2>
    <ul class="list tools">
      <li>
        <p class="title">Gabarito and Spline Sans Mono</p>
        <p class="license">Naipe Foundry, and Eben Sorkin and Mirko Velimirović. SIL Open Font License, via Fontsource.</p>
      </li>
      {
        software.map((t) => (
          <li>
            <p class="title">
              <a href={`https://www.npmjs.com/package/${t.name}`} rel="external noopener">{t.name}</a> <span class="mono version">{t.version}</span>
            </p>
            <p class="license">{t.license} license</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .facts {
    display: grid;
    gap: 0;
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }
  .facts div {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    gap: 6px 32px;
    padding-block: 20px;
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    font-weight: 700;
  }
  .facts dd {
    margin: 0;
    max-width: 44rem;
    color: var(--muted);
    text-wrap: pretty;
  }
  .group {
    text-wrap: balance;
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
  }
  .list li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding-block: 18px;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 88px;
  }
  .tools {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .title {
    font-weight: 700;
  }
  .version {
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 400;
  }
  .meta,
  .license {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .used {
    max-width: 38rem;
  }
  @media (max-width: 860px) {
    .facts div {
      grid-template-columns: minmax(0, 1fr);
    }
    .list,
    .tools {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
