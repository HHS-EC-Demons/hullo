---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { SOURCE_GROUPS } from '../data/source-index';
import { BRAND } from '../brand';

interface Pkg {
  version?: string;
  license?: string;
  repository?: string | { url?: string };
  dependencies?: Record<string, string>;
}

function repoUrl(repo: Pkg['repository']): string | null {
  const raw = typeof repo === 'string' ? repo : repo?.url;
  if (!raw) return null;
  return raw.replace(/^git\+/, '').replace(/\.git$/, '').replace(/^git:\/\//, 'https://');
}

interface Tool {
  name: string;
  url: string;
  version: string;
  license: string;
}

const readPkg = (path: string): Pkg => JSON.parse(readFileSync(resolve(process.cwd(), path), 'utf8')) as Pkg;
const packages = Object.keys(readPkg('package.json').dependencies ?? {})
  .filter((name) => !name.startsWith('@fontsource'))
  .map((name) => {
    const pkg = readPkg(`node_modules/${name}/package.json`);
    return { name, version: pkg.version ?? '', license: pkg.license ?? 'see package', repo: repoUrl(pkg.repository) };
  });
const scopes = new Map<string, typeof packages>();
for (const p of packages) {
  const scope = p.name.startsWith('@') ? p.name.split('/')[0] : '';
  if (scope) scopes.set(scope, [...(scopes.get(scope) ?? []), p]);
}
const grouped = new Set([...scopes].filter(([, list]) => list.length >= 3).map(([scope]) => scope));
const software: Tool[] = [
  ...packages
    .filter((p) => !grouped.has(p.name.split('/')[0]))
    .map((p) => ({ name: p.name, version: p.version, license: p.license, url: `https://www.npmjs.com/package/${p.name}` })),
  ...[...grouped].map((scope) => {
    const list = scopes.get(scope) ?? [];
    const versions = [...new Set(list.map((p) => p.version))];
    const licenses = [...new Set(list.flatMap((p) => p.license.split(/\s+and\s+/)))];
    return {
      name: `${scope}/*`,
      url: list.find((p) => p.repo)?.repo ?? `https://www.npmjs.com/package/${list[0].name}`,
      version: versions.length === 1 ? versions[0] : versions.join(', '),
      license: licenses.join(' and '),
    };
  }),
].sort((a, b) => a.name.localeCompare(b.name));

const groups = SOURCE_GROUPS.map((g) => ({ ...g, slug: `g-${g.key}` }));
---

<Base title="Sources" current="sources" description={`Every dataset, page and tool ${BRAND} uses, with its license and credit.`}>
  <header class="wrap page-head src-head">
    <div class="src-title">
      <h1>Sources</h1>
      <p>Every dataset, page and photo behind this site.</p>
    </div>
    <dl class="facts" aria-label="About this site">
      <div>
        <dt>Written for</dt>
        <dd>Readers 10 to 14 years old, and anyone curious.</dd>
      </div>
      <div>
        <dt>Use of AI</dt>
        <dd>Made with help from Claude by Anthropic. No image is AI generated.</dd>
      </div>
      <div>
        <dt>Passport</dt>
        <dd>Stamps and names stay in this browser. Nothing is sent.</dd>
      </div>
    </dl>
  </header>

  {
    groups.map((g) => (
      <section class="wrap section" aria-labelledby={g.slug}>
        <h2 class="group" id={g.slug}>
          {g.title}
        </h2>
        <ul class="list">
          {g.items.map((s) => (
            <li id={s.id}>
              <p class="title">
                <a href={s.url} rel="external noopener">{s.title}</a>
              </p>
              <details>
                <summary class="meta">
                  {s.publisher}, {s.dated}
                </summary>
                <p class="used">{s.used}</p>
                {s.note && <p class="note">{s.note}</p>}
                <p class="license">{s.license}</p>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="wrap section" aria-labelledby="tools">
    <h2 class="group" id="tools">Software and fonts</h2>
    <ul class="list tools">
      <li>
        <p class="title">Gabarito and Spline Sans Mono</p>
        <p class="license">Naipe Foundry, Eben Sorkin and Mirko Velimirović. SIL Open Font License.</p>
      </li>
      {
        software.map((t) => (
          <li>
            <p class="title">
              <a href={t.url} rel="external noopener">{t.name}</a> <span class="mono version">{t.version}</span>
            </p>
            <p class="license mono">{t.license}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .src-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px 56px;
    align-items: start;
    padding-top: clamp(28px, 4vw, 56px);
  }
  .src-head + .section {
    padding-top: clamp(16px, 2vw, 24px);
  }
  .facts {
    display: grid;
    gap: 0;
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }
  .facts div {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: 6px 28px;
    padding-block: 18px;
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    font-weight: 700;
  }
  .facts dd {
    margin: 0;
    max-width: 44rem;
    color: var(--muted);
    text-wrap: pretty;
  }
  .group {
    text-wrap: balance;
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
  }
  .list li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding-block: 18px;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 88px;
  }
  .tools {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .title {
    font-weight: 700;
  }
  .version {
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 400;
  }
  .meta,
  .license {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  details {
    display: grid;
    gap: 6px;
  }
  details[open] {
    padding-bottom: 6px;
  }
  summary {
    cursor: pointer;
    width: fit-content;
    text-underline-offset: 3px;
  }
  summary:hover {
    color: var(--text);
  }
  summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: 2px;
  }
  details > p {
    margin-top: 6px;
  }
  .used,
  .note {
    max-width: 38rem;
  }
  .note {
    color: var(--muted);
  }
  @media (max-width: 1023px) {
    .src-head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 860px) {
    .facts div {
      grid-template-columns: minmax(0, 1fr);
    }
    .list,
    .tools {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
