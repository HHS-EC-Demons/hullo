---
import Base from '../layouts/Base.astro';
import ProbeSignal from '../components/ProbeSignal';
import DsnNow, { type SitePhoto } from '../components/DsnNow';
import type { Poster } from '../components/EyesFacade';
import silentImages from '../data/silent-images.json';
import { href } from '../lib/paths';
import { meta, pic } from '../lib/photos';
import homeImages from '../data/home-images.json';
import { JOURNEY, hulloTime } from '../data/journey';

interface HomeImage {
  slug: string;
  group: string;
  site: string | null;
  id: string;
  when: string;
  kind: string;
  credit: string;
  caption: string;
  short: string;
  focus: string;
  alt: string;
}

const HOME = homeImages as Record<string, HomeImage>;
const credit = (id: string, by: string) => `${id}, ${by}.`;

const orbitData = Object.values(import.meta.glob<{ ORBIT_SITES?: unknown[] }>('../data/orbit-sites.ts', { eager: true }))[0];
const pageFiles = Object.keys(import.meta.glob('./*.astro'));

const sitePhotos: Record<string, SitePhoto> = {};
for (const m of Object.values(HOME)) {
  if (m.group !== 'dsn' || !m.site) continue;
  const p = await pic(m.slug, [400, 640, 900, 1200, 1600], '');
  sitePhotos[m.site] = { avif: p.avif, webp: p.webp, src: p.src, width: p.width, height: p.height, alt: m.alt, caption: m.short, credit: credit(m.id, m.credit) };
}
const dsnEyes = HOME['dsn-eyes-goldstone'];
const dsnPoster: Poster = {
  ...(await pic(dsnEyes.slug, [480, 720, 960, 1280, 1600], '')),
  alt: dsnEyes.alt,
  caption: dsnEyes.short,
  id: dsnEyes.id,
  credit: dsnEyes.credit,
  focus: dsnEyes.focus,
};
const surveyor = (silentImages as { object?: string; nasa_id: string; credit: string; date: string; alt?: string }[]).find((x) => x.object === 'surveyor3')!;

const TILE_WIDTHS = [360, 520, 720, 960, 1200, 1600];
const TILE_SIZES = '(max-width: 639px) 46vw, (max-width: 1023px) 31vw, 19vw';
const laser = meta('moon-laser-station');
const ingenuity = meta('mars-two-years');
const pluto = HOME['deep-newhorizons'];
const apollo14 = HOME['home-orbit-apollo14'];

const chapters = await Promise.all(
  JOURNEY.filter((c) => c.key !== 'orbit' || (orbitData?.ORBIT_SITES && pageFiles.includes('./orbit.astro'))).map(async (c, i) => ({
    ...c,
    n: i + 1,
    pic: await pic(c.slug, TILE_WIDTHS, TILE_SIZES),
    alt: HOME[c.slug]?.alt ?? c.alt,
    value: hulloTime(c.key, Date.now()),
  })),
);
---

<Base preload={['data/deep-space.json']}>
  <section class="wrap hero">
    <ProbeSignal client:load headline="h1" countdown home />
  </section>

  <section class="wrap section tiles-wrap" aria-labelledby="trip-h">
    <h2 id="trip-h" class="tiles-h">How long a hullo takes</h2>
    <ol class="tiles">
      {
        chapters.map((c) => (
          <li class="tile">
            <a href={href(c.path)} class="tile-link">
              <span class="tile-img ph">
              <picture>
                <source type="image/avif" srcset={c.pic.avif} sizes={TILE_SIZES} />
                <source type="image/webp" srcset={c.pic.webp} sizes={TILE_SIZES} />
                <img
                  src={c.pic.src}
                  width={c.pic.width}
                  height={c.pic.height}
                  alt={c.alt}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${c.focus}`}
                />
              </picture>
              </span>
              <span class="tile-row">
                <span class="tile-n mono">{c.n}</span>
                <span class="tile-name">{c.name}</span>
                <span class="tile-v mono">{c.value}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <DsnNow client:visible photos={sitePhotos} poster={dsnPoster} />
</Base>

<style>
  .hero {
    padding-top: clamp(20px, 3vw, 40px);
    padding-bottom: clamp(8px, 1.5vw, 16px);
  }
  :global(.dsn.section) {
    padding-block: clamp(32px, 4vw, 56px);
  }
  .tiles-wrap.section {
    padding-block: clamp(8px, 1.5vw, 16px) 0;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 40px clamp(14px, 1.6vw, 24px);
    padding-top: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--rule);
  }
  .tile {
    display: grid;
    align-content: start;
    gap: 10px;
    min-width: 0;
  }

  .tile-link {
    display: grid;
    gap: 16px;
    color: var(--text);
    text-decoration: none;
    border-radius: 4px;
  }
  .tile-link:focus-visible {
    outline-offset: 6px;
  }
  .tile-img {
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 2px;
    overflow: hidden;
  }
  .tile-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tiles-h {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: clamp(16px, 2vw, 24px);
  }
  .tile-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-bottom: 4px;
  }
  .tile-n {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .tile-v {
    margin-left: auto;
    color: var(--lilac);
    font-size: var(--fs-sm);
    white-space: nowrap;
  }
  .tile-name {
    font-weight: 700;
    font-size: var(--fs-lg);
    color: var(--text);
  }
  @media (hover: hover) {
    .tile-link:hover .tile-name {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
  @media (max-width: 1023px) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .tile-link {
      grid-template-columns: 88px minmax(0, 1fr);
      align-items: center;
      gap: 14px;
    }
    .tile-img {
      aspect-ratio: 1 / 1;
    }
    .tile-row {
      padding-bottom: 0;
    }
  }
</style>
