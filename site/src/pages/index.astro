---
import Base from '../layouts/Base.astro';
import ProbeSignal from '../components/ProbeSignal';
import DsnNow, { type SitePhoto } from '../components/DsnNow';
import { href } from '../lib/paths';
import { readData } from '../lib/build-data';
import { meta, pic } from '../lib/photos';
import homeImages from '../data/home-images.json';

interface HomeImage {
  slug: string;
  group: string;
  site: string | null;
  id: string;
  when: string;
  kind: string;
  credit: string;
  caption: string;
  short: string;
  alt: string;
}

const HOME = homeImages as Record<string, HomeImage>;
const LINE = 'Hardware in space, tracked with NASA data.';
const credit = (id: string, by: string) => `${id}, ${by}.`;

const moon = readData<{ round_trip_s: { min: number; max: number } }>('moon/index.json');
const mars = readData<{ totals: { flights: number } }>('ingenuity.json');
const deep = readData<{ probes: Record<string, unknown> }>('deep-space.json');
const orbitData = Object.values(import.meta.glob<{ ORBIT_SITES?: unknown[] }>('../data/orbit-sites.ts', { eager: true }))[0];
const pageFiles = Object.keys(import.meta.glob('./*.astro'));

const sitePhotos: Record<string, SitePhoto> = {};
for (const m of Object.values(HOME)) {
  if (m.group !== 'dsn' || !m.site) continue;
  const p = await pic(m.slug, [400, 640, 900, 1200, 1600], '');
  sitePhotos[m.site] = { avif: p.avif, webp: p.webp, src: p.src, width: p.width, height: p.height, alt: m.alt, caption: m.short, credit: credit(m.id, m.credit) };
}

const TILE_WIDTHS = [360, 520, 720, 960, 1200, 1600];
const TILE_SIZES = '(max-width: 639px) calc(100vw - 32px), (max-width: 1023px) 46vw, 23vw';
const laser = meta('moon-laser-station');
const ingenuity = meta('mars-two-years');
const pluto = HOME['deep-newhorizons'];
const apollo14 = HOME['home-orbit-apollo14'];

const chapters = [
  {
    path: 'deep-space/',
    name: 'Deep space',
    value: String(Object.keys(deep.probes).length),
    unit: 'probes',
    pic: await pic(pluto.slug, TILE_WIDTHS, TILE_SIZES),
    focus: '50% 50%',
    alt: pluto.alt,
    caption: 'Pluto, 2015',
    credit: credit(pluto.id, pluto.credit),
  },
  {
    path: 'moon/',
    name: 'Moon',
    value: `${moon.round_trip_s.min.toFixed(1)}-${moon.round_trip_s.max.toFixed(1)}`,
    unit: 's',
    pic: await pic('moon-laser-station', TILE_WIDTHS, TILE_SIZES),
    focus: '50% 0%',
    alt: 'Two green laser beams rising from an observatory into a dark blue night sky toward the bright Moon.',
    caption: `Goddard laser, ${laser.date!.slice(0, 4)}`,
    credit: credit(laser.id, laser.credit),
  },
  {
    path: 'mars/',
    name: 'Mars',
    value: String(mars.totals.flights),
    unit: 'flights',
    pic: await pic('mars-two-years', TILE_WIDTHS, TILE_SIZES),
    focus: '45% 50%',
    alt: 'Ingenuity, a small helicopter with two long rotor blades on four thin legs, standing on rocky reddish ground.',
    caption: `Ingenuity, ${ingenuity.date!.slice(0, 4)}`,
    credit: credit(ingenuity.id, ingenuity.credit),
  },
  ...(orbitData?.ORBIT_SITES && pageFiles.includes('./orbit.astro')
    ? [
        {
          path: 'orbit/',
          name: 'Orbit',
          value: String(orbitData.ORBIT_SITES.length),
          unit: 'sites',
          pic: await pic(apollo14.slug, TILE_WIDTHS, TILE_SIZES),
          focus: '50% 50%',
          alt: apollo14.alt,
          caption: apollo14.short,
          credit: credit(apollo14.id, apollo14.credit),
        },
      ]
    : []),
];
---

<Base preload={['data/deep-space.json']}>
  <section class="wrap hero">
    <ProbeSignal client:load headline="h1" aside={LINE} picker="form" countdown />
  </section>

  <DsnNow client:visible photos={sitePhotos} />

  <section class="wrap section tiles-wrap" aria-label="Chapters">
    <ul class="tiles">
      {
        chapters.map((c) => (
          <li class="tile">
            <a href={href(c.path)} class="tile-link" aria-label={`${c.name}, ${c.value} ${c.unit}`}>
              <picture>
                <source type="image/avif" srcset={c.pic.avif} sizes={TILE_SIZES} />
                <source type="image/webp" srcset={c.pic.webp} sizes={TILE_SIZES} />
                <img
                  src={c.pic.src}
                  width={c.pic.width}
                  height={c.pic.height}
                  alt={c.alt}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${c.focus}`}
                />
              </picture>
              <span class="tile-row">
                <span class="press tile-btn">{c.name}</span>
                <span class="tile-num">
                  {c.value}<span class="tile-unit">{c.unit}</span>
                </span>
              </span>
            </a>
            <p class="credit">
              {c.caption}. <span data-credit>{c.credit}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(32px, 6vw, 80px);
    padding-bottom: clamp(56px, 9vw, 128px);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px clamp(14px, 1.6vw, 24px);
    padding-top: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--rule);
  }
  .tile {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .tile-link {
    display: grid;
    gap: 16px;
    color: var(--text);
    text-decoration: none;
    border-radius: 4px;
  }
  .tile-link:focus-visible {
    outline-offset: 6px;
  }
  .tile-link img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--raised);
    border-radius: 2px;
  }
  .tile-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 4px;
  }
  .tile-btn {
    min-height: 44px;
    padding-inline: 16px;
  }
  @media (hover: hover) {
    .tile-link:hover .tile-btn {
      background: var(--p-fill-hover);
    }
  }
  .tile-link:active .tile-btn {
    transform: translateY(var(--press-lip-h, 3px));
    box-shadow: 0 0 0 var(--p-lip);
  }
  .tile-num {
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }
  .tile-unit {
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--muted);
    margin-left: 0.25em;
  }
  @media (max-width: 1023px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
    .tile-link img {
      aspect-ratio: 4 / 5;
    }
  }
</style>
