---
import Base from '../layouts/Base.astro';
import IngenuityMap, { type Flight, type FlightPhoto } from '../components/IngenuityMap';
import PlanetFigure from '../components/PlanetFigure.astro';
import SoundClip from '../components/SoundClip';
import { readData } from '../lib/build-data';
import { meta, pic } from '../lib/photos';
import photoData from '../data/photos.json';
import sounds from '../data/sounds.json';


const ing = readData<{ totals: { flights: number; nasa_km: number; nasa_minutes: number }; mission_page: string; flights: Flight[] }>('ingenuity.json');
const opening = { ...ing.flights[0], path: [] };
const rotors = sounds.find((s) => s.id === 'ingenuity-rotors')!;

const shots: { n: number; slug: string; alt: string }[] = [
  { n: 1, slug: 'mars-flight01', alt: 'Ingenuity’s shadow on the sand, from the helicopter’s black and white navigation camera.' },
  { n: 2, slug: 'mars-flight02', alt: 'Reddish ground from 5 m up, crossed by the tracks of Perseverance’s wheels.' },
  { n: 5, slug: 'mars-flight05', alt: 'The floor of Jezero crater from 10 m up, sand with scattered rocks.' },
  { n: 9, slug: 'mars-flight09', alt: 'Rippled sand dunes from above, with part of Ingenuity’s landing gear in the top left corner.' },
  { n: 26, slug: 'mars-flight26', alt: 'Perseverance’s backshell lying upright on the ground with parachute cables spread around the backshell, from 8 m up.' },
  { n: 54, slug: 'mars-flight54', alt: 'Perseverance seen from about 5 m up, a small shape near the top right of the frame.' },
  { n: 66, slug: 'mars-flight66', alt: 'Marks left by Ingenuity’s feet in the sand, seen from above.' },
  { n: 70, slug: 'mars-flight70', alt: 'A wide field of sand ripples from about 12 m up.' },
  { n: 72, slug: 'mars-flight72', alt: 'The shadow of a damaged rotor blade on the sand after Ingenuity’s last flight.' },
];

const photos: FlightPhoto[] = await Promise.all(
  shots.map(async (s) => {
    const m = meta(s.slug);
    return {
      n: s.n,
      alt: s.alt,
      date: m.date!,
      credit: `${m.id}, ${m.credit}`,
      pic: await pic(s.slug, [400, 640, 960], '(max-width: 860px) 92vw, 30vw'),
    };
  }),
);

const hero = meta('mars-two-years');
const vanZyl = photoData['mars-van-zyl'];
const selfie = meta('mars-selfie');
const valinor = photoData['mars-valinor'];
const mark = valinor.mark as [number, number];

function span(from: string, to: string): string {
  return from.slice(0, 7) === to.slice(0, 7) ? `${from} to ${to.slice(5)}` : `${from} to ${to}`;
}
---

<Base title="Mars" current="mars" description="Every one of Ingenuity’s 72 flights over Jezero crater on JPL’s map, with NASA’s flight log and photos from the helicopter.">
  <header class="wrap page-head mars-hero">
    <div class="mars-hero-text">
      <h1>Mars</h1>
      <p>Built for 5 flights, Ingenuity flew {ing.totals.flights}.</p>
    </div>
    <PlanetFigure
      slug="mars-two-years"
      class="mars-hero-photo"
      eager
      sizes="(max-width: 860px) 92vw, 46vw"
      alt="Ingenuity standing on rocky ground, its two stacked rotors, dusty solar panel and four thin legs in sharp detail."
      what="Ingenuity, enhanced color"
      date={hero.date!}
      credit={`${hero.id}, ${hero.credit}`}
    />
  </header>

  <section class="wrap" aria-label="Ingenuity flights">
    <div class="map-slot">
      <IngenuityMap client:visible photos={photos} opening={opening} flights={ing.totals.flights} />
    </div>
    <p class="credit map-credit" data-credit>M20_HiRISE_RGB_CTX_mosaic_25cm_v7, NASA/JPL-Caltech/University of Arizona/MSSS.</p>
  </section>

  <section class="mars-seen section" aria-label="Seen by Perseverance">
    <PlanetFigure
      slug="mars-van-zyl"
      class="mars-wide"
      sizes="100vw"
      alt="A wide panorama of Jezero crater’s floor, reddish sand scattered with pale rocks under a butterscotch sky, with low hills along the horizon."
      what="Van Zyl Overlook"
      date={span(vanZyl.date, vanZyl.until)}
      credit={`${vanZyl.id}, ${vanZyl.credit}`}
    />
    <div class="wrap mars-pair">
      <PlanetFigure
        slug="mars-selfie"
        sizes="(max-width: 860px) 92vw, 54vw"
        alt="Perseverance’s selfie on Mars, with Ingenuity standing on the ground about 3.9 m in front of the rover."
        what="Perseverance and Ingenuity"
        date={selfie.date!}
        credit={`${selfie.id}, ${selfie.credit}`}
      />
      <div class="mars-sound">
        <h2 class="mars-h3">Flight 4 rotor hum</h2>
        <SoundClip
          client:visible
          src={rotors.file}
          peaks={rotors.peaks}
          duration={rotors.duration_s}
          label="Ingenuity’s fourth flight, recorded by Perseverance"
          stampId="ingenuity"
          stampDetail="Heard flight 4, recorded 30 Apr 2021 from 80 m away"
        >
          SuperCam microphone, <span class="mono">{rotors.recorded}</span>. <span data-credit>{rotors.credit}.</span>
        </SoundClip>
      </div>
    </div>
  </section>

  <section class="mars-end" aria-labelledby="end-h">
    <div class="wrap mars-claim">
      <h2 id="end-h" class="big-claim"><span class="n mono">{ing.totals.nasa_km.toFixed(1)} km</span> in {ing.totals.nasa_minutes.toFixed(1)} minutes</h2>
      <p>Rotor damage on flight 72 ended the mission.</p>
    </div>
    <PlanetFigure
      slug="mars-valinor"
      class="mars-wide"
      sizes="100vw"
      mark={mark}
      alt="Rippled orange sand dunes with a few rocks, and Ingenuity as a tiny dark speck inside a lilac ring left of center."
      what="Ingenuity at its last airfield"
      date={valinor.date}
      credit={`${valinor.id}, ${valinor.credit}`}
    />
  </section>
</Base>

<style>
  .mars-hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 32px 64px;
    align-items: end;
  }
  .mars-hero-text {
    padding-bottom: 56px;
  }
  .map-slot {
    min-height: calc(clamp(420px, 46vw, 600px) + 300px);
  }
  .map-credit {
    margin-top: 14px;
    max-width: 48rem;
  }
  .mars-h3 {
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }
  .mars-seen :global(.mars-wide),
  .mars-end :global(.mars-wide) {
    --pf-cap-pad: calc(max(0px, (100% - var(--max)) / 2) + var(--gutter));
    max-width: 1920px;
    margin-inline: auto;
  }
  .mars-pair {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px 64px;
    align-items: end;
    margin-top: clamp(40px, 6vw, 80px);
  }
  .mars-sound {
    display: grid;
    gap: 18px;
    padding-bottom: 28px;
  }
  .mars-end {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .mars-claim {
    display: grid;
    gap: 14px;
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .mars-claim p {
    max-width: 30rem;
    font-size: var(--fs-md);
    color: var(--muted);
  }
  .big-claim {
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .big-claim .n {
    display: block;
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  @media (max-width: 860px) {
    .mars-hero,
    .mars-pair {
      grid-template-columns: minmax(0, 1fr);
    }
    .mars-hero-text {
      padding-bottom: 0;
    }
    .map-slot {
      min-height: calc(clamp(360px, 92vw, 520px) + 900px);
    }
    .mars-seen :global(.mars-wide) {
      --pf-ratio: 16 / 9;
      --pf-pos: 42% 50%;
    }
  }
</style>
