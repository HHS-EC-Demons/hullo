---
import Base from '../layouts/Base.astro';
import OrbitSites, { type SiteProps, type ViewProps } from '../components/OrbitSites';
import { ORBIT_SITES, type OrbitSite, type OrbitView } from '../data/orbit-sites';
import { utcDate } from '../lib/client';
import { LRO, image, lro, meta, pic } from '../lib/photos';
import sounds from '../data/sounds.json';

const dated = (iso: string): string => utcDate(Date.parse(`${iso.slice(0, 10)}T12:00:00Z`));

const SIZES = '(max-width: 760px) 100vw, 50vw';
const PAIR_SIZES = '(max-width: 900px) 92vw, 820px';
const WIDTHS = [640, 800, 1080, 1400, 1800];

function widths(slug: string): number[] {
  const native = Math.min(image(slug).width, 2400);
  return [...WIDTHS.filter((w) => w < native), native];
}

function coords(site: OrbitSite): string {
  const places = site.body === 'Moon' ? 3 : 1;
  const lon = site.body === 'Moon' ? site.lon : ((site.lon % 360) + 360) % 360;
  const ns = `${Math.abs(site.lat).toFixed(places)}° ${site.lat < 0 ? 'S' : 'N'}`;
  const ew = site.body === 'Moon' ? `${Math.abs(lon).toFixed(places)}° ${lon < 0 ? 'W' : 'E'}` : `${lon.toFixed(places)}° E`;
  return `${ns}, ${ew}`;
}

function apart(a: string, b: string): string {
  const years = Math.floor((Date.parse(b) - Date.parse(a)) / (365.25 * 86400000));
  return years === 1 ? '1 year apart' : `${years} years apart`;
}

function label(id: string): string {
  return /^as\d/i.test(id) ? id.toUpperCase() : id;
}

function short(by: string): string {
  if (by.endsWith(' crew')) return 'Crew';
  if (by.startsWith('Viking')) return 'Lander';
  return by;
}

async function view(site: OrbitSite, v: OrbitView): Promise<{ props: ViewProps; date: string; detail: string }> {
  if (v.slug.endsWith('-lro')) {
    const c = lro(site.id);
    return {
      date: c.acquired.slice(0, 10),
      detail: `LROC ${c.product}, ${c.scale_m} m per pixel`,
      props: {
        pic: await pic(v.slug, widths(v.slug), SIZES),
        alt: v.alt,
        when: c.acquired.slice(0, 10),
        by: v.by,
        caption: `${c.product}, ${LRO.credit}.`,
        ring: [(c.lm_px[0] / c.width) * 100, (c.lm_px[1] / c.height) * 100],
      },
    };
  }
  const m = meta(v.slug);
  const date = m.date ?? site.landed;
  return {
    date,
    detail: `HiRISE view from ${dated(date)}`,
    props: {
      pic: await pic(v.slug, widths(v.slug), site.pair ? PAIR_SIZES : SIZES),
      alt: v.alt,
      when: date,
      by: short(v.by),
      caption: `${label(m.id)}, ${m.credit}.`,
    },
  };
}

const quake = sounds.find((s) => s.id === 'insight-quake')!;

async function build(body: 'Moon' | 'Mars'): Promise<SiteProps[]> {
  return Promise.all(
    ORBIT_SITES.filter((s) => s.body === body).map(async (s) => {
      const then = await view(s, s.then);
      const now = await view(s, s.now);
      return {
        id: s.id,
        name: s.name,
        tab: body === 'Moon' ? s.name.replace(/^Apollo /, '') : s.name,
        where: coords(s),
        apart: apart(then.date, now.date),
        then: then.props,
        now: now.props,
        pair: !!s.pair,
        stampDetail: now.detail,
        sound:
          s.sound === 'insight-quake'
            ? {
                src: quake.file,
                peaks: quake.peaks,
                duration: quake.duration_s,
                label: 'InSight’s biggest marsquake as sound',
                stampId: 'insight',
                stampDetail: 'Heard the magnitude 5 quake of 4 May 2022',
                what: 'Magnitude 5 marsquake as sound',
                date: quake.recorded,
                credit: `PIA25281, ${quake.credit}`,
              }
            : undefined,
      } satisfies SiteProps;
    }),
  );
}

const moon = await build('Moon');
const mars = await build('Mars');
---

<Base title="Orbit" current="orbit" description="Apollo landing sites seen by LRO and Mars landers seen by HiRISE, each next to a photo from landing.">
  <header class="wrap page-head">
    <h1>Orbit</h1>
    <p>Landing sites, seen later from orbit.</p>
  </header>

  <section class="orbit-sec" aria-labelledby="moon-h">
    <h2 id="moon-h" class="wrap orbit-h2">Moon</h2>
    <OrbitSites client:visible label="Apollo landing sites" sites={moon} first="apollo11" eager />
  </section>

  <section class="orbit-sec rule-top" aria-labelledby="mars-h">
    <h2 id="mars-h" class="wrap orbit-h2">Mars</h2>
    <OrbitSites client:visible label="Mars landing sites" sites={mars} first="phoenix" />
  </section>
</Base>

<style>
  .orbit-sec {
    display: grid;
    gap: 24px;
    padding-block: clamp(24px, 4vw, 48px);
  }
  .rule-top {
    border-top: 1px solid var(--rule);
    margin-top: clamp(24px, 4vw, 48px);
    padding-top: clamp(32px, 5vw, 64px);
  }
  .orbit-h2 {
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }
</style>
