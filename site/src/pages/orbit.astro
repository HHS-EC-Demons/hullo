---
import Base from '../layouts/Base.astro';
import OrbitSites, { type MapProps, type Mark, type SiteProps, type ViewProps } from '../components/OrbitSites';
import { ORBIT_SITES, type OrbitSite, type OrbitView } from '../data/orbit-sites';
import { calDate } from '../lib/dates';
import { LRO, image, lro, meta, pic } from '../lib/photos';
import sounds from '../data/sounds.json';
import siteMaps from '../data/orbit-maps.json';

const SIZES = '(max-width: 640px) 92vw, (max-width: 1360px) 46vw, 620px';
const PAIR_SIZES = '(max-width: 900px) 92vw, 820px';
const MAP_SIZES = '(max-width: 640px) 92vw, (max-width: 1023px) 46vw, (max-width: 1360px) 31vw, 420px';
const WIDTHS = [640, 800, 1080, 1400, 1800];

function widths(slug: string): number[] {
  const native = Math.min(image(slug).width, 2400);
  return [...WIDTHS.filter((w) => w < native), native];
}

function coords(site: OrbitSite): string {
  const places = site.body === 'Moon' ? 3 : 1;
  const lon = site.body === 'Moon' ? site.lon : ((site.lon % 360) + 360) % 360;
  const ns = `${Math.abs(site.lat).toFixed(places)}° ${site.lat < 0 ? 'S' : 'N'}`;
  const ew = site.body === 'Moon' ? `${Math.abs(lon).toFixed(places)}° ${lon < 0 ? 'W' : 'E'}` : `${lon.toFixed(places)}° E`;
  return `${ns}, ${ew}`;
}

function apart(a: string, b: string): string {
  const years = Math.floor((Date.parse(b) - Date.parse(a)) / (365.25 * 86400000));
  return years === 1 ? '1 year apart' : `${years} years apart`;
}

function label(id: string): string {
  return /^as\d/i.test(id) ? id.toUpperCase() : id;
}

function short(by: string): string {
  if (by.endsWith(' crew')) return 'Crew';
  if (by.startsWith('Viking')) return 'Lander';
  return by;
}

async function view(site: OrbitSite, v: OrbitView): Promise<{ props: ViewProps; date: string; detail: string }> {
  if (v.slug.endsWith('-lro')) {
    const c = lro(site.id);
    const date = c.acquired.slice(0, 10);
    const mark: Mark = { ring: [c.lm_px[0] / c.width, c.lm_px[1] / c.height], ringSize: 0.09, metersPerPx: c.scale_m };
    return {
      date,
      detail: `LROC ${c.product}, ${c.scale_m} m per pixel`,
      props: {
        pic: await pic(v.slug, widths(v.slug), SIZES),
        alt: v.alt,
        when: calDate(date),
        by: v.by,
        caption: `${c.product}, ${LRO.credit}.`,
        mark,
      },
    };
  }
  const m = meta(v.slug);
  const date = m.date ?? site.landed;
  return {
    date,
    detail: `HiRISE view from ${calDate(date)}`,
    props: {
      pic: await pic(v.slug, widths(v.slug), site.pair ? PAIR_SIZES : SIZES),
      alt: v.alt,
      when: calDate(date),
      by: short(v.by),
      caption: `${label(m.id)}, ${m.credit}.`,
    },
  };
}

const quake = sounds.find((s) => s.id === 'insight-quake')!;

const sites: SiteProps[] = await Promise.all(
  ORBIT_SITES.map(async (s) => {
    const then = await view(s, s.then);
    const now = await view(s, s.now);
    return {
      id: s.id,
      name: s.name,
      tab: s.body === 'Moon' ? s.name.replace(/^Apollo /, '') : s.name,
      body: s.body,
      where: coords(s),
      apart: apart(then.date, now.date),
      look: s.look,
      then: then.props,
      now: now.props,
      pair: !!s.pair,
      stampDetail: now.detail,
      sound:
        s.sound === 'insight-quake'
          ? {
              src: quake.file,
              peaks: quake.peaks,
              duration: quake.duration_s,
              label: 'InSight’s biggest marsquake as sound',
              stampId: 'insight',
              stampDetail: 'Heard the magnitude 5 quake of 4 May 2022',
              what: 'Magnitude 5 marsquake as sound',
              date: calDate(quake.recorded),
              credit: `PIA25281, ${quake.credit}`,
            }
          : undefined,
    } satisfies SiteProps;
  }),
);

type MapMeta = { file: string; west: number; east: number; north: number; south: number; id: string; year: number; credit: string };

async function siteMap(body: 'Moon' | 'Mars', m: MapMeta, alt: string): Promise<MapProps> {
  const slug = m.file.replace(/\.jpg$/, '');
  return {
    body,
    pic: await pic(slug, widths(slug), MAP_SIZES),
    alt,
    what: body,
    year: m.year,
    credit: `${m.id}, ${m.credit}`,
    pins: ORBIT_SITES.filter((s) => s.body === body).map((s) => {
      const lon = body === 'Mars' && s.lon < m.west ? s.lon + 360 : s.lon;
      return {
        id: s.id,
        name: s.name,
        x: ((lon - m.west) / (m.east - m.west)) * 100,
        y: ((m.north - s.lat) / (m.north - m.south)) * 100,
      };
    }),
  };
}

const maps = [
  await siteMap('Moon', siteMaps.moon, 'The near side of the Moon around the Apollo landing sites, grey highlands and dark lava plains, with the bright rays of Copernicus crater on the left.'),
  await siteMap('Mars', siteMaps.mars, 'A flat map of all of Mars, reddish with dark patches, white polar caps and the big Tharsis volcanoes near the middle.'),
];
---

<Base title="Orbit" current="orbit" description="Apollo landing sites seen by LRO and Mars landers seen by HiRISE, each next to a photo from landing, picked from maps of the Moon and Mars.">
  <OrbitSites client:load sites={sites} maps={maps} first="apollo11">
    <Fragment slot="head">
      <h1 class="orbit-h1">Orbit</h1>
      <p class="orbit-line">Landing sites, seen later from orbit.</p>
    </Fragment>
  </OrbitSites>
</Base>

<style>
  .orbit-h1 {
    font-size: var(--fs-display);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .orbit-line {
    margin-top: 18px;
    max-width: var(--measure);
    font-size: var(--fs-md);
    color: var(--muted);
    text-wrap: pretty;
  }
</style>
