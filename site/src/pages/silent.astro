---
import Base from '../layouts/Base.astro';
import QuietTimeline, { type TimelinePhoto } from '../components/QuietTimeline';
import QuietNow from '../components/QuietNow';
import { SILENT } from '../data/silent';
import { lifelines, type ReflectorInfo } from '../data/timeline';
import SILENT_PHOTOS from '../data/silent-images.json';
import PAGE_PHOTOS from '../data/page-images.json';
import PHOTOS from '../data/photos.json';
import PROBE_PHOTOS from '../data/probe-photos.json';
import { readData } from '../lib/build-data';
import { pic } from '../lib/photos';
import { calDate } from '../lib/dates';

const READOUT = '(max-width: 860px) 120px, 416px';
const WALL = '(max-width: 640px) 100vw, (max-width: 1179px) 50vw, 300px';

interface PublicImage {
  slug: string;
  nasa_id: string;
  title: string;
  credit: string;
  page: string;
}

function shortDate(iso: string): string {
  return calDate(iso);
}

const hero = PAGE_PHOTOS['silent-hero'];
const heroPic = await pic('silent-hero', [640, 960, 1280, 1920, 2400], '(max-width: 959px) 100vw, 720px');

const photos: Record<string, TimelinePhoto> = {};
const wall: Record<string, { avif: string; webp: string; src: string; width: number; height: number }> = {};
for (const m of SILENT_PHOTOS) {
  const slug = `silent-${m.object}`;
  const [small, big] = await Promise.all([pic(slug, [240, 480, 720, 960], READOUT), pic(slug, [400, 600, 800, 1200], WALL)]);
  const name = SILENT.find((s) => s.id === m.object)?.name ?? m.object;
  photos[m.object] = {
    ...small,
    alt: 'alt' in m && m.alt ? m.alt : `${name}. ${m.title}`,
    nasaId: m.nasa_id,
    credit: m.credit,
    page: m.page,
    caption: m.caption,
    when: m.when,
  };
  wall[m.object] = big;
}

const a11 = readData<PublicImage[]>('images.json').find((p) => p.slug === 'apollo11-reflector');
const a14 = (PHOTOS as Record<string, { id: string; credit: string; page: string; date: string | null }>)['moon-a14-reflector'];
const borrowed = [
  a11 && { id: 'a11', slug: 'home-apollo11-reflector', nasaId: a11.nasa_id, credit: a11.credit, page: a11.page, caption: 'Apollo 11’s experiments package on the Moon', when: '20 Jul 1969', alt: 'Two small instruments on grey lunar ground, a seismometer with solar panels and a flat laser reflector.' },
  a14 && { id: 'a14', slug: 'moon-a14-reflector', nasaId: a14.id, credit: a14.credit, page: a14.page, caption: 'The Apollo 14 laser reflector on the Moon', when: a14.date ? shortDate(a14.date) : '', alt: 'A flat grid of laser reflectors on a stand on grey lunar ground.' },
  ...PROBE_PHOTOS.filter((p) => !photos[p.probe]).map((p) => ({ id: p.probe, slug: p.slug, nasaId: p.nasa_id, credit: p.credit, page: p.page, caption: p.caption.replace(/\.$/, ''), when: '', alt: p.alt })),
];
for (const b of borrowed) {
  if (!b || photos[b.id]) continue;
  const small = await pic(b.slug, [240, 480, 720, 960], READOUT).catch(() => null);
  if (!small) continue;
  photos[b.id] = { ...small, alt: b.alt, nasaId: b.nasaId, credit: b.credit, page: b.page, caption: b.caption, when: b.when };
}

const moon = readData<{ reflectors: ReflectorInfo[] }>('moon/index.json');
const lines = lifelines(moon.reflectors);
const builtMs = Date.now();

const rows = SILENT.filter((s) => wall[s.id]).map((s) => ({
  ...s,
  when: shortDate(s.date),
  pic: wall[s.id],
  photo: photos[s.id],
}));
---

<Base title="The silent ones" current="silent" description="NASA hardware that no longer answers, with the date each one went quiet and a photo of each.">
  <header class="wrap page-head silent-head">
    <div class="silent-title">
      <h1>The silent ones</h1>
      <p>NASA’s legacy hardware</p>
    </div>
    <figure class="silent-hero">
      <picture class="ph">
        <source type="image/avif" srcset={heroPic.avif} sizes={heroPic.sizes} />
        <source type="image/webp" srcset={heroPic.webp} sizes={heroPic.sizes} />
        <img src={heroPic.src} width={heroPic.width} height={heroPic.height} alt={hero.alt} loading="eager" fetchpriority="high" decoding="async" />
      </picture>
    </figure>
    <QuietNow client:idle lines={lines} builtMs={builtMs} />
  </header>

  <section class="wrap timeline" aria-label="When each object went quiet">
    <QuietTimeline client:idle lines={lines} photos={photos} builtMs={builtMs} first="insight" />
  </section>

  <section class="wrap" aria-label="Photos of the silent objects">
    <ol class="wall">
      {
        rows.map((r) => (
          <li id={r.id}>
            <figure>
              <picture class="ph">
                <source type="image/avif" srcset={r.pic.avif} sizes={WALL} />
                <source type="image/webp" srcset={r.pic.webp} sizes={WALL} />
                <img src={r.pic.src} width={r.pic.width} height={r.pic.height} alt={`${r.photo.alt} ${r.photo.caption}, ${r.photo.when}.`} loading="lazy" decoding="async" />
              </picture>
              <figcaption>
                <span class="wall-name">{r.name}</span>
                <time class="wall-when mono" datetime={r.date}>
                  {r.date.slice(0, 4)}
                </time>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .silent-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-areas:
      'title photo'
      'now photo';
    gap: 28px 56px;
    align-items: start;
    padding-top: clamp(28px, 4vw, 56px);
  }
  .silent-title {
    grid-area: title;
  }
  .silent-hero {
    grid-area: photo;
    align-self: stretch;
    margin: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
  }
  .silent-hero picture {
    display: block;
    min-height: 0;
  }
  .silent-hero img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 24rem;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .silent-hero .ph,
  .wall .ph {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .section-title {
    text-wrap: balance;
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .timeline {
    margin-bottom: clamp(56px, 8vw, 112px);
  }
  .wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 44px 24px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }
  .wall li {
    scroll-margin-top: 96px;
  }
  .wall figure {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .wall img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .wall figcaption {
    display: grid;
    gap: 2px;
  }
  .wall-name {
    font-size: var(--fs-lg);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .wall-when {
    margin-bottom: 4px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 1179px) {
    .wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 959px) {
    .silent-head {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        'title'
        'photo'
        'now';
      row-gap: 24px;
    }
    .silent-hero img {
      height: auto;
      min-height: 0;
      aspect-ratio: 3 / 2;
    }
  }
  @media (max-width: 640px) {
    .wall {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
  }
</style>
