---
import Base from '../layouts/Base.astro';
import ProbeSignal from '../components/ProbeSignal';
import ProbeDistance from '../components/ProbeDistance';
import ProbeEyes from '../components/ProbeEyes';
import ProbeSky from '../components/ProbeSky';
import SoundClip from '../components/SoundClip';
import sounds from '../data/sounds.json';
import { pic } from '../lib/photos';
import homeImages from '../data/home-images.json';
import silentImages from '../data/silent-images.json';
import type { ProbePhoto } from '../components/ProbeSignal';
import type { Poster } from '../components/EyesFacade';

interface HomeImage {
  slug: string;
  group: string;
  probe: string | null;
  id: string;
  credit: string;
  short: string;
  focus: string;
  alt: string;
}

const plasma = sounds.find((s) => s.id === 'voyager-plasma')!;
const HOME = Object.values(homeImages as Record<string, HomeImage>);

const photos: Record<string, ProbePhoto> = {};
for (const m of HOME) {
  if (m.group !== 'deep' || !m.probe) continue;
  const p = await pic(m.slug, [480, 720, 960, 1280, 1600, 2000, 2400], '');
  photos[m.probe] = { ...p, alt: m.alt, caption: `${m.short}.`, id: m.id, credit: m.credit, focus: m.focus };
}

const POSTER_WIDTHS = [640, 960, 1280, 1600, 2000, 2400];
const posters: Record<string, Poster> = {};
for (const m of HOME) {
  if (m.group !== 'eyes' || !m.probe) continue;
  const p = await pic(m.slug, POSTER_WIDTHS, '');
  posters[m.probe] = { ...p, alt: m.alt, caption: m.short, id: m.id, credit: m.credit, focus: m.focus };
}
const launch = (silentImages as { object?: string; nasa_id: string; credit: string; alt?: string }[]).find((s) => s.object === 'pioneer11');
if (launch) {
  const p = await pic('silent-pioneer11', POSTER_WIDTHS, '');
  posters.pioneer11 = {
    ...p,
    alt: launch.alt ?? 'The Atlas-Centaur rocket carrying Pioneer 11 lifting off at night in a cloud of smoke.',
    caption: 'Pioneer 11 launch, 1973',
    id: launch.nasa_id,
    credit: launch.credit,
    focus: '48% 40%',
  };
}
---

<Base title="Deep space" current="deep-space" preload={['data/deep-space.json']} description="Light time and message travel time to Voyager 1 and 2, New Horizons and Pioneer 10 and 11, from JPL Horizons.">
  <section class="wrap">
    <ProbeSignal client:load picker="top" status photos={photos} title="Deep space" line="Message a probe leaving the solar system." />
  </section>

  <section class="wrap listen" aria-labelledby="listen-h">
    <h2 id="listen-h">Interstellar plasma</h2>
    <SoundClip
      client:visible
      src={plasma.file}
      peaks={plasma.peaks}
      duration={plasma.duration_s}
      label="Voyager 1 plasma wave recording"
      stampId="voyager1"
      stampDetail="Played the plasma wave recording from Oct 2012 to May 2013"
      source="Voyager 1, 2012 and 2013. PIA17045, NASA/JPL-Caltech/University of Iowa"
    />
  </section>

  <section class="wrap block" aria-label="3D view">
    <ProbeEyes client:visible posters={posters} />
  </section>

  <section class="wrap block dist" aria-labelledby="dist-h">
    <h2 id="dist-h">From the Sun</h2>
    <ProbeDistance client:visible />
  </section>

  <section class="wrap">
    <ProbeSky client:visible chart={false} />
  </section>
</Base>

<style>
  .listen {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    align-items: center;
    gap: 20px clamp(32px, 4vw, 64px);
    margin-top: clamp(36px, 4.5vw, 64px);
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .listen h2,
  .dist h2 {
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    text-wrap: balance;
  }
  .block {
    margin-top: clamp(36px, 4.5vw, 64px);
  }
  .dist {
    display: grid;
    gap: 24px;
  }
  @media (max-width: 900px) {
    .listen {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
